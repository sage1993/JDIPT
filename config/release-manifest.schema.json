{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sage1993/JDIPT/releases/release-manifest.schema.json",
  "title": "JDIPT Unified Release Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "repository",
    "installed",
    "active_runtime",
    "oracle",
    "static_validation",
    "suites",
    "hard_gates",
    "source_correctness",
    "runtime_host_acceptance",
    "case_inventory",
    "evidence",
    "final"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "repository": {
      "type": "object",
      "required": ["sha", "dirty", "changed_file_digest_manifest"],
      "properties": {
        "sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
        "dirty": {"type": "boolean"},
        "changed_file_digest_manifest": {"type": "object", "additionalProperties": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "installed": {
      "type": "object",
      "required": ["plugin_version", "manifest_digest", "integrity_status"],
      "properties": {
        "plugin_version": {"type": "string", "minLength": 1},
        "manifest_digest": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "integrity_status": {"enum": ["PASS", "FAIL"]}
      },
      "additionalProperties": true
    },
    "active_runtime": {
      "type": "object",
      "required": ["plugin_id", "source_path", "runtime_digest", "identity_status"],
      "properties": {
        "plugin_id": {"type": "string", "minLength": 1},
        "source_path": {"type": "string", "minLength": 1},
        "runtime_digest": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "identity_status": {"enum": ["PASS", "FAIL"]}
      },
      "additionalProperties": true
    },
    "oracle": {
      "type": "object",
      "required": ["version", "digest"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
      },
      "additionalProperties": true
    },
    "static_validation": {
      "type": "object",
      "required": ["pytest", "validate_repo", "authority_temporal", "compileall", "npm_ci", "npm_audit", "plugin_integrity", "diff_check"],
      "properties": {
        "pytest": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
        "validate_repo": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
        "authority_temporal": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
        "compileall": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
        "npm_ci": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
        "npm_audit": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
        "plugin_integrity": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
        "diff_check": {"enum": ["PASS", "FAIL", "NOT_RUN"]}
      },
      "additionalProperties": true
    },
    "suites": {
      "type": "object",
      "required": ["core", "full", "ansim", "stability"],
      "properties": {
        "core": {"$ref": "#/$defs/suiteEvidence"},
        "full": {"$ref": "#/$defs/suiteEvidence"},
        "ansim": {"$ref": "#/$defs/suiteEvidence"},
        "stability": {"$ref": "#/$defs/suiteEvidence"}
      },
      "additionalProperties": true
    },
    "hard_gates": {
      "type": "object",
      "required": ["status", "violations", "critical_negative_markers"],
      "properties": {
        "status": {"enum": ["PASS", "FAIL"]},
        "violations": {"type": "array"},
        "critical_negative_markers": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": true
    },
    "source_correctness": {
      "type": "object",
      "required": ["status", "failures"],
      "properties": {"status": {"enum": ["PASS", "FAIL"]}, "failures": {"type": "array"}},
      "additionalProperties": true
    },
    "runtime_host_acceptance": {
      "type": "object",
      "required": ["status", "identity_status", "failures"],
      "properties": {
        "status": {"enum": ["PASS", "FAIL"]},
        "identity_status": {"enum": ["PASS", "FAIL"]},
        "failures": {"type": "array"}
      },
      "additionalProperties": true
    },
    "case_inventory": {
      "type": "object",
      "required": ["core", "full", "ansim", "stability"],
      "properties": {
        "core": {"$ref": "#/$defs/caseInventory"},
        "full": {"$ref": "#/$defs/caseInventory"},
        "ansim": {"$ref": "#/$defs/caseInventory"},
        "stability": {"$ref": "#/$defs/caseInventory"}
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "required": ["generated_at", "snapshot_id"],
      "properties": {"generated_at": {"type": "string", "minLength": 1}, "snapshot_id": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}},
      "additionalProperties": true
    },
    "final": {
      "type": "object",
      "required": ["verdict", "reasons"],
      "properties": {"verdict": {"enum": ["UNSET", "PASS", "HOLD"]}, "reasons": {"type": "array", "items": {"type": "string"}}},
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$defs": {
    "suiteEvidence": {
      "type": "object",
      "required": ["status", "snapshot_id", "case_ids", "pass_count", "expected_count"],
      "properties": {
        "status": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
        "snapshot_id": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "case_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "pass_count": {"type": "integer", "minimum": 0},
        "expected_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "caseInventory": {
      "type": "object",
      "required": ["expected", "observed"],
      "properties": {
        "expected": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "observed": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": true
    }
  }
}
