{
  "description": "JDIPT bounded runtime synthesis integrity gate",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/jdipt_activation.py\"",
            "commandWindows": "py -3 ${CLAUDE_PLUGIN_ROOT}\\scripts\\jdipt_activation.py",
            "timeout": 30,
            "statusMessage": "Detecting explicit JDIPT activation"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^mcp__jdipt_runtime__register_material_proposition$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/inject_registry_runtime.py\"",
            "commandWindows": "py -3 ${CLAUDE_PLUGIN_ROOT}\\scripts\\inject_registry_runtime.py",
            "timeout": 30,
            "statusMessage": "Binding JDIPT runtime state"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/stop_synthesis_gate.py\"",
            "commandWindows": "py -3 ${CLAUDE_PLUGIN_ROOT}\\scripts\\stop_synthesis_gate.py",
            "timeout": 30,
            "statusMessage": "Checking JDIPT synthesis integrity"
          }
        ]
      }
    ]
  }
}
